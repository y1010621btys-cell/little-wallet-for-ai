# 淘宝 MCP（tb_mcp.py），监听 127.0.0.1:8009。
# 必须跑在能读到常驻浏览器 profile + 钱包的用户下（我们用 root）。
# 装好放 /etc/systemd/system/，然后：
#   systemctl daemon-reload && systemctl enable --now wallet-tbmcp
# 再在 nginx 加一条秘密路由 /tb-mcp-<secret>/ → 127.0.0.1:8009/（照 wallet-mcp 抄），
# 把 https://你的域名/tb-mcp-<secret>/ 当连接器加进 AI 端。
[Unit]
Description=Papa Taobao MCP
After=network.target taobao-browser.service

[Service]
WorkingDirectory=/root/wallet
ExecStart=/root/wallet/venv/bin/python tb_mcp.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
